GEMAI_API_KEY=
GEMAI_BASE_URL=https://api.gemai.cc/v1
# Optional explicit proxy for model requests only; blank means no override.
MODEL_PROXY_URL=
# Verify these IDs with `python scripts/provider_probe.py`; GemAI exposes tagged model IDs.
GEMAI_FAST_MODEL=[满血A]gemini-2.5-flash
GEMAI_RESEARCH_MODEL=deepseek-v4-flash
GEMAI_SYNTHESIS_MODEL=deepseek-v4-flash
GEMAI_JUDGE_MODEL=claude-sonnet-5
TAVILY_API_KEY=
DATABASE_URL=postgresql+psycopg://ci@127.0.0.1:5432/ci_agent
OBJECT_STORE_ROOT=data/objects
ALLOWED_DOMAINS=*
MAX_SEARCHES=12
MAX_PAGES=30
MAX_MODEL_REQUESTS=24
MAX_AGENT_CALLS=4
MAX_COST_CNY=3.0
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=ci-minio
MINIO_SECRET_KEY=ci-minio-secret
MINIO_BUCKET=ci-artifacts
SERVICE_API_KEY=
# Optional authorized Taobao app credential JSON; values remain server-side.
# JSON keys: tenant_id, app_key, app_secret, session. Never commit real values.
CI_SOURCE_SHOP_TAOBAO_CREDENTIALS=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
